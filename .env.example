# Postgres connection (pooled URL is fine for the app)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leaklens
# Optional: direct (unpooled) URL used for migrations when DATABASE_URL is a pooler
DATABASE_URL_UNPOOLED=
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Optional: Google AI Studio key for column-mapping suggestions. Without it the app uses rule-based suggestions.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash-lite)
GEMINI_MODEL=
# Optional: seed size (default 12000 orders)
SEED_ORDERS=
